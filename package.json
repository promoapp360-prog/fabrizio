{
  "name": "vecciari-grano-brace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && next build --webpack",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:deploy": "sh -c 'if [ -d prisma/migrations ]; then prisma migrate deploy; else prisma db push; fi'",
    "db:setup": "prisma migrate dev --name init && npm run db:seed",
    "admin:set": "tsx scripts/set-admin.ts",
    "menu:demo": "tsx scripts/update-menu-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@google-cloud/storage": "^9.0.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
