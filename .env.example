# ── Obbligatorie ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/vecciari?sslmode=require"
# Stringa casuale >= 32 caratteri (es. `openssl rand -base64 48`)
AUTH_SECRET=""
# URL pubblico del sito, usato nei QR code (es. https://vecciari.it)
PUBLIC_BASE_URL="http://localhost:3000"
# Password del primo Super Admin (accesso al gestionale con sola password)
SEED_ADMIN_PASSWORD=""

# ── Storage immagini S3-compatibile (AWS S3, Cloudflare R2, Backblaze…) ──
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── Integrazioni opzionali (vuote = mostrate come "non configurate") ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
NEXT_PUBLIC_GA4_ID=""
GOOGLE_MAPS_EMBED_URL=""
